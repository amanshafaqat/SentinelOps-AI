# ==============================================================================
# SentinelOps AI - Environment Configuration Template
# ==============================================================================
# Security Notice:
# 1. Do NOT commit real secrets or production credentials into version control.
# 2. Copy this file to .env and fill in environment-specific values.
# 3. All API keys (e.g. GEMINI_API_KEY) must ONLY be accessed server-side.
# ==============================================================================

# Application Environment
APP_NAME="SentinelOps AI"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# API Server Configuration
API_HOST="0.0.0.0"
API_PORT=8001
API_V1_PREFIX="/api/v1"

# CORS Configuration (comma-separated or JSON list of allowed origins)
# For security, only allow trusted frontend development and production origins
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000", "https://ais-dev-64jcuffnkhvjkongyehjem-606669253437.asia-southeast1.run.app"]'

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Default development local postgres instance:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinelops"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Authentication & Security (Future Phases)
# Generate a high-entropy secret in production (e.g., openssl rand -hex 32)
JWT_SECRET_KEY="replace_with_a_secure_random_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Copilot Configuration (Server-Side ONLY - Never expose to frontend)
# Used in Phase 5 for evidence-grounded incident investigation copilot
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3-flash-preview"
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_CONTEXT_EVENTS=50
GEMINI_RATE_LIMIT_PER_MINUTE=30
